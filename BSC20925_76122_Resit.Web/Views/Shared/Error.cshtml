@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <div class="display-1 text-danger">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h1 class="display-4 text-danger">Oops! Something went wrong.</h1>
    
    @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
    {
        <div class="alert alert-danger mt-4 mx-auto" style="max-width: 600px;">
            <strong>Error:</strong> @Model.ErrorMessage
        </div>
    }
    else
    {
        <p class="lead text-muted">An error occurred while processing your request.</p>
    }
    
    @if (Model?.ShowRequestId == true)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
    
    <div class="mt-4">
        <a asp-controller="Claims" asp-action="Dashboard" class="btn btn-primary">
            <i class="bi bi-house"></i> Go to Dashboard
        </a>
        <a asp-controller="Claims" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-list-ul"></i> View Claims
        </a>
    </div>
</div>