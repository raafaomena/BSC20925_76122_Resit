@model IEnumerable<BSC20925_76122_Resit.Web.Models.InsuranceClaim>
@{
    ViewData["Title"] = "Claims";
    var currentRole = ViewBag.CurrentRole as string ?? "Student";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-list-ul"></i> Claims</h1>
    <div>
        <span class="badge @(currentRole == "Manager" ? "bg-danger" : "bg-primary") me-2" style="font-size: 0.9rem; padding: 0.5rem 1rem;">
            <i class="bi bi-shield-check"></i> @currentRole
        </span>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> New Claim
        </a>
    </div>
</div>

<div class="search-filters">
    <form method="get" class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input type="text" name="searchTerm" class="form-control" placeholder="Customer name or policy number" value="@ViewBag.SearchTerm" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select" asp-items="ViewBag.StatusList">
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Claim Type</label>
            <select name="claimType" class="form-select" asp-items="ViewBag.ClaimTypeList">
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Filter
            </button>
        </div>
    </form>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <small class="text-muted">Sort by:</small>
        <a asp-route-sortBy="ClaimDate" asp-route-sortOrder="@(ViewBag.SortBy == "ClaimDate" && ViewBag.SortOrder == "asc" ? "desc" : "asc")" class="btn btn-sm btn-outline-secondary">
            Date <i class="bi bi-arrow-@(ViewBag.SortBy == "ClaimDate" && ViewBag.SortOrder == "asc" ? "up" : "down")"></i>
        </a>
        <a asp-route-sortBy="EstimatedAmount" asp-route-sortOrder="@(ViewBag.SortBy == "EstimatedAmount" && ViewBag.SortOrder == "asc" ? "desc" : "asc")" class="btn btn-sm btn-outline-secondary">
            Amount <i class="bi bi-arrow-@(ViewBag.SortBy == "EstimatedAmount" && ViewBag.SortOrder == "asc" ? "up" : "down")"></i>
        </a>
    </div>
    <div class="col-md-6 text-end">
        <small class="text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</small>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <p class="lead mt-3">No claims found matching your criteria.</p>
        <a asp-action="Create" class="btn btn-primary">Create your first claim</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Reference</th>
                    <th>Customer</th>
                    <th>Policy</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td><strong>@claim.ClaimReference</strong></td>
                        <td>@claim.CustomerName</td>
                        <td>@claim.PolicyNumber</td>
                        <td>@claim.ClaimType</td>
                        <td>@claim.ClaimDate.ToString("dd/MM/yyyy")</td>
                        <td>@claim.EstimatedAmount.ToString("C")</td>
                        <td>
                            <span class="claim-status-badge claim-status-@claim.ClaimStatus.Replace(" ", "")">
                                @claim.ClaimStatus
                            </span>
                        </td>
                        <td>
                            @if (currentRole == "Manager")
                            {
                                <a asp-action="Details" asp-route-id="@claim.Id" class="btn btn-sm btn-info" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@claim.Id" class="btn btn-sm btn-warning" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@claim.Id" class="btn btn-sm btn-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Read Only</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@ViewBag.Status" asp-route-claimType="@ViewBag.ClaimType" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder">
                        Previous
                    </a>
                </li>
            }
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@ViewBag.Status" asp-route-claimType="@ViewBag.ClaimType" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder">
                        @i
                    </a>
                </li>
            }
            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@ViewBag.Status" asp-route-claimType="@ViewBag.ClaimType" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder">
                        Next
                    </a>
                </li>
            }
        </ul>
    </nav>
}