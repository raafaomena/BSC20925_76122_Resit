@model BSC20925_76122_Resit.Web.Models.InsuranceClaim
@{
    ViewData["Title"] = "Edit Claim - " + Model.ClaimReference;
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0"><i class="bi bi-pencil"></i> Edit Claim: @Model.ClaimReference</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="CreatedBy" />
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ClaimReference" class="form-label"></label>
                                <input asp-for="ClaimReference" class="form-control" />
                                <span asp-validation-for="ClaimReference" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="PolicyNumber" class="form-label"></label>
                                <input asp-for="PolicyNumber" class="form-control" />
                                <span asp-validation-for="PolicyNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="CustomerName" class="form-label"></label>
                                <input asp-for="CustomerName" class="form-control" />
                                <span asp-validation-for="CustomerName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="CustomerEmail" class="form-label"></label>
                                <input asp-for="CustomerEmail" class="form-control" type="email" />
                                <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ClaimType" class="form-label"></label>
                                <select asp-for="ClaimType" class="form-select" asp-items="ViewBag.ClaimTypeList"></select>
                                <span asp-validation-for="ClaimType" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ClaimStatus" class="form-label"></label>
                                <select asp-for="ClaimStatus" class="form-select" asp-items="ViewBag.StatusList"></select>
                                <span asp-validation-for="ClaimStatus" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ClaimDate" class="form-label"></label>
                                <input asp-for="ClaimDate" class="form-control" type="date" />
                                <span asp-validation-for="ClaimDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="IncidentDate" class="form-label"></label>
                                <input asp-for="IncidentDate" class="form-control" type="date" />
                                <span asp-validation-for="IncidentDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="EstimatedAmount" class="form-label"></label>
                        <input asp-for="EstimatedAmount" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="EstimatedAmount" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Save
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}