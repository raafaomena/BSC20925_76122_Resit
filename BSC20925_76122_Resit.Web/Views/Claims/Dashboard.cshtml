@model IEnumerable<BSC20925_76122_Resit.Web.Models.InsuranceClaim>
@{
    ViewData["Title"] = "Dashboard";
    var statusCounts = ViewBag.StatusCounts as Dictionary<string, int>;
    var totalClaims = ViewBag.TotalClaims as int?;
    var currentRole = ViewBag.CurrentRole as string ?? "Student";
    var colors = new Dictionary<string, string>
    {
        { "Submitted", "info" },
        { "Under Review", "warning" },
        { "Approved", "success" },
        { "Rejected", "danger" }
    };
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1><i class="bi bi-speedometer2"></i> Dashboard</h1>
    </div>
    <div class="col-md-4 text-end">
        <div class="btn-group" role="group">
            <a asp-action="SetRole" asp-route-role="Student" class="btn @(currentRole == "Student" ? "btn-primary" : "btn-outline-secondary")">
                <i class="bi bi-person"></i> Student
            </a>
            <a asp-action="SetRole" asp-route-role="Manager" class="btn @(currentRole == "Manager" ? "btn-danger" : "btn-outline-secondary")">
                <i class="bi bi-person-badge"></i> Manager
            </a>
        </div>
        <span class="badge @(currentRole == "Manager" ? "bg-danger" : "bg-primary") ms-2" style="font-size: 1rem; padding: 0.5rem 1rem;">
            <i class="bi bi-shield-check"></i> @currentRole
        </span>
    </div>
</div>

@if (currentRole == "Manager")
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> You are viewing as <strong>Manager</strong> - Full access to all claims
    </div>
}
else
{
    <div class="alert alert-secondary">
        <i class="bi bi-info-circle"></i> You are viewing as <strong>Student</strong> - View and create claims only
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card dashboard-card bg-primary text-white">
            <div class="card-body">
                <div class="card-title">Total Claims</div>
                <div class="card-value">@totalClaims</div>
            </div>
        </div>
    </div>
    
    @if (statusCounts != null)
    {
        @foreach (var status in statusCounts)
        {
            var color = colors.ContainsKey(status.Key) ? colors[status.Key] : "secondary";
            <div class="col-md-3">
                <div class="card dashboard-card text-white bg-@color">
                    <div class="card-body">
                        <div class="card-title">@status.Key</div>
                        <div class="card-value">@status.Value</div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Claims</h5>
                <a asp-action="Index" class="btn btn-primary btn-sm">View All Claims</a>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center my-3">No recent claims.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Customer</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    @if (currentRole == "Manager")
                                    {
                                        <th>Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model)
                                {
                                    <tr>
                                        <td>@claim.ClaimReference</td>
                                        <td>@claim.CustomerName</td>
                                        <td>@claim.ClaimType</td>
                                        <td>@claim.EstimatedAmount.ToString("C")</td>
                                        <td>
                                            <span class="claim-status-badge claim-status-@claim.ClaimStatus.Replace(" ", "")">
                                                @claim.ClaimStatus
                                            </span>
                                        </td>
                                        @if (currentRole == "Manager")
                                        {
                                            <td>
                                                <a asp-action="Details" asp-route-id="@claim.Id" class="btn btn-sm btn-outline-info">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@claim.Id" class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@claim.Id" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <span class="badge bg-secondary">Read Only</span>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>