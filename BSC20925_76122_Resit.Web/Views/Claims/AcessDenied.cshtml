@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center mt-5 py-5">
    <div class="display-1 text-danger">
        <i class="bi bi-exclamation-octagon"></i>
    </div>
    <h1 class="display-4 text-danger">Access Denied</h1>
    <p class="lead">You do not have permission to access this page.</p>
    <p class="text-muted">Switch to <strong>Manager</strong> mode to access this feature.</p>
    <div class="mt-4">
        <a asp-action="Dashboard" class="btn btn-primary">
            <i class="bi bi-house"></i> Go to Dashboard
        </a>
        <a asp-action="SetRole" asp-route-role="Manager" class="btn btn-danger">
            <i class="bi bi-person-badge"></i> Switch to Manager
        </a>
    </div>
</div>